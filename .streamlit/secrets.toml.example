# Copie para .streamlit/secrets.toml (local) ou cole em Settings > Secrets (Streamlit Cloud).
# Nunca suba o secrets.toml para o GitHub.

# Pode colar o mesmo bloco de secrets do app do formulário (SHEET_ID, NOME_ABA, gcp_service_account).
# ABA_RESPOSTAS e ABA_LOJAS são opcionais: sem elas vale NOME_ABA (ou "Respostas") e "Hierarquia".
SHEET_ID = "id-da-planilha-CheckListAcompanhamento"
NOME_ABA = "Respostas"
# ABA_LOJAS = "Hierarquia"

# Liga quando o login com a conta Microsoft existir (apps de regional e coordenador).
TRAVAR_POR_EMAIL = false

[gcp_service_account]
type = "service_account"
project_id = "checklist-facta"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "streamlit-checklist@checklist-facta.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
